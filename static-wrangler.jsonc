{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attendance-pedro",
  "main": "static-worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
